<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="ComplexCabinetRechargeRecovery">
    <ReactiveSequence>
      <ReactiveFallback>
        <BatteryCharged battery_level="80"/>
        <ReactiveFallback>
          <ReactiveSequence>
            <NearDock/>
            <Dock/>
          </ReactiveSequence>
          <ApproachChargingStation/>
        </ReactiveFallback>
      </ReactiveFallback>
      <ReactiveFallback>
        <IsUndocked/>
        <Undock/>
      </ReactiveFallback>
    </ReactiveSequence>
  </BehaviorTree>

  <BehaviorTree ID="ComplexRecoveryCabinetExample">
    <Sequence>
      <ReactiveSequence>
        <ReactiveFallback>
          <BatteryCharged battery_level="80"/>
          <Dock/>
        </ReactiveFallback>
        <ReactiveFallback>
          <IsUndocked/>
          <Undock/>
        </ReactiveFallback>
        <ReactiveFallback>
          <IsStanding/>
          <SelfCorrect/>
        </ReactiveFallback>
        <ReactiveFallback>
          <IsNearCabinet/>
          <ApproachCabinet/>
        </ReactiveFallback>
        <ReactiveFallback>
          <IsCabinetOpen/>
          <ReactiveSequence>
            <ReactiveFallback>
              <IsCabinetUnlocked/>
              <UnlockCabinet/>
            </ReactiveFallback>
            <OpenCabinet/>
          </ReactiveSequence>
        </ReactiveFallback>
        <ReactiveFallback>
          <IsCupGrasped/>
          <GrabCup/>
        </ReactiveFallback>
      </ReactiveSequence>
      <PlaceCup/>
    </Sequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="ApproachCabinet"
            editable="true"/>
    <Action ID="ApproachChargingStation"
            editable="true"/>
    <Condition ID="BatteryCharged"
               editable="true">
      <input_port name="battery_level"
                  default="80"
                  type="double"/>
    </Condition>
    <Action ID="Dock"
            editable="true"/>
    <Action ID="GrabCup"
            editable="true"/>
    <Condition ID="IsCabinetOpen"
               editable="true"/>
    <Condition ID="IsCabinetUnlocked"
               editable="true"/>
    <Condition ID="IsCupGrasped"
               editable="true"/>
    <Condition ID="IsNearCabinet"
               editable="true"/>
    <Condition ID="IsStanding"
               editable="true"/>
    <Condition ID="IsUndocked"
               editable="true"/>
    <Condition ID="NearDock"
               editable="true"/>
    <Action ID="OpenCabinet"
            editable="true"/>
    <Action ID="PlaceCup"
            editable="true"/>
    <Action ID="SelfCorrect"
            editable="true"/>
    <Action ID="Undock"
            editable="true"/>
    <Action ID="UnlockCabinet"
            editable="true"/>
  </TreeNodesModel>

</root>
