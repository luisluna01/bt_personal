<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="ComplexRecoveryCabinetExample">
    <Sequence>
      <ReactiveSequence>
        <ReactiveFallback>
          <ReactiveSequence>
            <LowBattery battery_level="10"/>
            <Dock/>
          </ReactiveSequence>
          <ReactiveSequence>
            <IsDocked/>
            <Undock/>
          </ReactiveSequence>
        </ReactiveFallback>
        <ReactiveFallback>
          <IsStanding/>
          <SelfCorrect/>
        </ReactiveFallback>
        <ReactiveFallback>
          <IsNearCabinet/>
          <ApproachCabinet/>
        </ReactiveFallback>
        <ReactiveFallback>
          <IsCabinetOpen/>
          <ReactiveSequence>
            <ReactiveFallback>
              <IsCabinetUnlocked/>
              <UnlockCabinet/>
            </ReactiveFallback>
            <OpenCabinet/>
          </ReactiveSequence>
        </ReactiveFallback>
        <ReactiveFallback>
          <IsCupGrasped/>
          <GrabCup/>
        </ReactiveFallback>
      </ReactiveSequence>
      <PlaceCup/>
    </Sequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="ApproachCabinet"
            editable="true"/>
    <Action ID="Dock"
            editable="true"/>
    <Action ID="GrabCup"
            editable="true"/>
    <Condition ID="IsCabinetOpen"
               editable="true"/>
    <Condition ID="IsCabinetUnlocked"
               editable="true"/>
    <Condition ID="IsCupGrasped"
               editable="true"/>
    <Condition ID="IsDocked"
               editable="true"/>
    <Condition ID="IsNearCabinet"
               editable="true"/>
    <Condition ID="IsStanding"
               editable="true"/>
    <Condition ID="LowBattery"
               editable="true">
      <input_port name="battery_level"
                  default="10"
                  type="double"/>
    </Condition>
    <Action ID="OpenCabinet"
            editable="true"/>
    <Action ID="PlaceCup"
            editable="true"/>
    <Action ID="SelfCorrect"
            editable="true"/>
    <Action ID="Undock"
            editable="true"/>
    <Action ID="UnlockCabinet"
            editable="true"/>
  </TreeNodesModel>

</root>
