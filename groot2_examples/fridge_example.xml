<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="FridgeExample">
    <Sequence>
      <ApproachFridge/>
      <OpenFridge/>
      <SubTree ID="GrabCan"
               _autoremap="false"/>
      <CloseFridge/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="GrabCan">
    <Sequence>
      <OpenGripper/>
      <MoveHandToCan/>
      <CloseGripper/>
      <RetractArm/>
    </Sequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="ApproachFridge"
            editable="true"/>
    <Action ID="CloseFridge"
            editable="true"/>
    <Action ID="CloseGripper"
            editable="true"/>
    <Action ID="MoveHandToCan"
            editable="true"/>
    <Action ID="OpenFridge"
            editable="true"/>
    <Action ID="OpenGripper"
            editable="true"/>
    <Action ID="RetractArm"
            editable="true"/>
  </TreeNodesModel>

</root>
