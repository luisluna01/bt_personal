<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="CabinetExampleWithRecovery">
    <ReactiveSequence>
      <ReactiveFallback>
        <ReactiveSequence>
          <LowBattery battery_level="20"/>
          <Recharge/>
        </ReactiveSequence>
        <NearCup/>
        <ApproachCup/>
      </ReactiveFallback>
      <ReactiveFallback>
        <CupGrasped/>
        <GrabCup/>
      </ReactiveFallback>
      <ReactiveFallback>
        <NearCabinet/>
        <ApproachCabinet/>
      </ReactiveFallback>
      <ReactiveFallback>
        <CabinetOpen/>
        <OpenCabinet/>
      </ReactiveFallback>
      <PlaceCup/>
    </ReactiveSequence>
  </BehaviorTree>

  <BehaviorTree ID="CabinetRechargeRecovery">
    <ReactiveSequence>
      <LowBattery battery_level="20"/>
      <Recharge/>
    </ReactiveSequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="ApproachCabinet"
            editable="true"/>
    <Action ID="ApproachCup"
            editable="true"/>
    <Condition ID="CabinetOpen"
               editable="true"/>
    <Condition ID="CupGrasped"
               editable="true"/>
    <Action ID="GrabCup"
            editable="true"/>
    <Condition ID="LowBattery"
               editable="true">
      <input_port name="battery_level"
                  default="10"
                  type="double"/>
    </Condition>
    <Condition ID="NearCabinet"
               editable="true"/>
    <Condition ID="NearCup"
               editable="true"/>
    <Action ID="OpenCabinet"
            editable="true"/>
    <Action ID="PlaceCup"
            editable="true"/>
    <Action ID="Recharge"
            editable="true"/>
  </TreeNodesModel>

</root>
